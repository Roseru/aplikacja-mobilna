# Local development only. Replace credentials; never use these on a public server.
DATABASE_URL=postgresql+psycopg://calorie_app_api:local-dev-api@127.0.0.1:5432/calorie_app
# Run Alembic with this role, not the API role:
# DATABASE_URL=postgresql+psycopg://calorie_app_migrator:local-dev-migrator@127.0.0.1:5432/calorie_app
DB_CONNECT_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=2000
# Optional explicit CA bundle for a private HTTPS OIDC provider (verification stays enabled):
# OIDC_CA_BUNDLE=/absolute/path/to/ca.pem
# API reads; operator CLI writes. Mount the same durable filesystem for both.
CATALOG_ARTIFACT_ROOT=./var/catalog
# Before serving official pagination, set a persistent secret generated once:
# python -c "import secrets; print(secrets.token_hex(32))"
# Same secret on every API replica and restart; keep out of Git/logs.
# CATALOG_PAGE_TOKEN_SECRET=<64 lowercase hex digits>

# AI stays in mock mode until the existing E7/E9 operator procedure is completed.
AI_PROVIDER=mock
# Backend only; never put a Gemini key in the APK or commit a real value.
# GEMINI_API_KEY=<private backend secret>
# AI_PROJECT_ID=<confirmed project>
# AI_ENVIRONMENT_ID=<stable confirmed environment>
# AI_MODEL=<model verified under docs/e7/KONFIGURACJA_O3.md>
# AI_LIVE_CONFIRMATION=<absolute private dated confirmation JSON path>
# Configure the existing pool with actual confirmed limits; mock/demo limits
# are not real quotas. Preserve history and restore fences.
# See docs/e7/KONFIGURACJA_O3.md and docs/e9/KONFIGURACJA_O3.md.
