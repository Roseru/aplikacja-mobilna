# Local development only. Replace credentials; never use these on a public server.
DATABASE_URL=postgresql+psycopg://calorie_app_api:local-dev-api@127.0.0.1:5432/calorie_app
# Run Alembic with this role, not the API role:
# DATABASE_URL=postgresql+psycopg://calorie_app_migrator:local-dev-migrator@127.0.0.1:5432/calorie_app
DB_CONNECT_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=2000
