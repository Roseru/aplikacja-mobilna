{
    admin off
    auto_https off
    persist_config off
}

https://:8443 {
    tls /run/tls/server.pem /run/tls/server.key
    # No access logging, caching or token-bearing URLs in operational output.
    header Cache-Control "no-store"
    header -Server
    @identity path /realms/* /resources/* /admin/*
    handle @identity {
        reverse_proxy keycloak:8080
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health/* {
        reverse_proxy api:8000
    }
    respond "Local integration environment" 200
}
