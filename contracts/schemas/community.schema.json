        "revision",
        "canonical_ref",
        "state_revision",
        "name",
        "aliases",
        "brand",
        "variant",
        "identity",
        "basis_unit",
        "nutrition_per_100",
        "portion",
        "density",
        "source_id",
        "source_kind",
        "source_description",
        "provenance",
        "verification",
        "visibility",
        "complete",
        "missing_nutrition_fields",
        "missing_identity_fields",
        "positive_votes",
        "negative_votes",
        "voters",
        "is_mine"
