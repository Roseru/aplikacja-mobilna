          "title": "Provenance"
        },
        "verification": {
          "type": "string",
          "enum": [
            "unverified",
            "verified"
          ],
          "title": "Verification"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "visible",
            "hidden"
          ],
          "title": "Visibility"
        },
        "complete": {
          "type": "boolean",
          "title": "Complete"
        },
        "missing_nutrition_fields": {
          "items": {
            "type": "string",
            "enum": [
              "energy_kcal",
              "protein_g",
              "fat_g",
              "carbs_g"
            ]
          },
          "type": "array",
          "maxItems": 4,
          "title": "Missing Nutrition Fields"
        },
        "missing_identity_fields": {
          "items": {
            "type": "string",
            "enum": [
              "brand",
              "variant",
              "composition",
              "energy_kcal"
            ]
          },
          "type": "array",
          "maxItems": 4,
          "title": "Missing Identity Fields"
